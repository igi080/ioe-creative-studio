{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/portfolio/demos/school-result-portal",
      "destination": "/index.html"
    },
    {
      "source": "/portfolio/demos/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/portfolio/demo/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/demos/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/school-result-portal",
      "destination": "/index.html"
    },
    {
      "source": "/portfolio",
      "destination": "/index.html"
    },
    {
      "source": "/portfolio/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/request-quote",
      "destination": "/index.html"
    },
    {
      "source": "/quote",
      "destination": "/index.html"
    },
    {
      "source": "/about",
      "destination": "/index.html"
    },
    {
      "source": "/services",
      "destination": "/index.html"
    },
    {
      "source": "/contact",
      "destination": "/index.html"
    },
    {
      "source": "/pricing",
      "destination": "/index.html"
    },
    {
      "source": "/checkout",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/|images/|videos/|assets/|favicon|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
