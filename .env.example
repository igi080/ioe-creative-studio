# Vercel Deployment Settings
# (Vercel automatically injects its own environment variables during build)

# ==============================================================================
# FRONTEND / BROWSER PUBLIC VARIABLES (Exposed in client bundle via Vite)
# ==============================================================================

# Supabase Database & Auth (Required for public queries and client-side admin login)
# Supabase Project URL (e.g. https://xyzcompany.supabase.co - NOT ending in /rest/v1/)
VITE_SUPABASE_URL=
# Supabase Publishable / Anon Key (Safe for client browsers)
VITE_SUPABASE_PUBLISHABLE_KEY=

# Paystack Public Key (Optional for client-side popup checkout)
VITE_PAYSTACK_PUBLIC_KEY=

# Cloudflare R2 Public CDN / Bucket URL (For reading uploaded images in the browser)
VITE_R2_PUBLIC_URL=https://pub-24582a54e2714c96a2baaaf19911cd68.r2.dev

# ==============================================================================
# SERVER-SIDE SECRETS (NEVER exposed to frontend browsers, configured in Vercel)
# ==============================================================================

# Supabase Service Role Key (Server-side only for elevated admin operations/webhooks)
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 Storage Credentials (For presigned upload URLs & deletions)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ioe-creative-studio-media
R2_PUBLIC_URL=https://pub-24582a54e2714c96a2baaaf19911cd68.r2.dev

# Paystack Secret Key (For payment initialization, verification, and webhooks)
PAYSTACK_SECRET_KEY=

# Performance Advertising & Conversion Tracking
# (Optional: If omitted, tracking fails gracefully with zero errors and no fake IDs)
# Meta Pixel (Facebook / Instagram Ads) - Format: numeric ID (e.g., 123456789012345)
VITE_META_PIXEL_ID=
# Google Analytics 4 (Google Tag / Ads) - Format: G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=

