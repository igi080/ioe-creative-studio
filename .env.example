# Vercel Deployment Settings
# (Vercel automatically injects its own environment variables during build)

# Supabase Database & Auth (Required for Management Section)
# Obtain these from your Supabase Project Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare R2 Media Storage (Required for Product Images)
# Obtain these from your Cloudflare Dashboard > R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ioe-creative-studio-media
R2_PUBLIC_URL=

# Paystack Online Payments (Required for Checkout)
# Obtain these from your Paystack Dashboard > Settings > API Keys & Webhooks
VITE_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Google Drive Backups (Required for Archive Storage)
# Obtain these from Google Cloud Console > APIs & Services > Credentials
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# Performance Advertising & Conversion Tracking
# (Optional: If omitted, tracking fails gracefully with zero errors and no fake IDs)
# Meta Pixel (Facebook / Instagram Ads) - Format: numeric ID (e.g., 123456789012345)
VITE_META_PIXEL_ID=
# Google Analytics 4 (Google Tag / Ads) - Format: G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=

